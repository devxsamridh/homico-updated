# Local development only. Replace example JWT values before using them.
PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/homico
# Comma-separated exact browser origins; set the production frontend origin in hosting settings.
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_unique_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_unique_random_refresh_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Used only by the development seed script.
SEED_PASSWORD=replace_with_a_local_seed_password
